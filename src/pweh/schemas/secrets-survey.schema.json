                  "unsupported_unicode"
                ]
              },
              "minItems": 0,
              "maxItems": 12,
              "uniqueItems": true
            }
          },
          "required": [
            "input_bytes",
            "read_bytes",
            "scanned_bytes",
            "framing_bytes",
            "unscanned_bytes",
            "scanned_ranges",
            "unscanned_ranges",
            "lines_seen",
            "lines_scanned",
            "lines_skipped",
            "analysis_complete",
            "container_examined",
            "selection_uncertain",
            "hits_are_lower_bound",
            "reasons"
          ]
        },
        "matches": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "pattern_ids": {
                "type": "array",
                "items": {
                  "enum": [
                    "builtin-config-password",
                    "builtin-xml-password",
                    "builtin-url-credential",
                    "builtin-quoted-password",
                    "console-space-password",
                    "console-quoted-value",
                    "console-authorization",
                    "console-bearer",
                    "console-jwt",
                    "console-xml-secret",
                    "console-url-credential",
                    "scanner-explicit-credential"
                  ]
                },
                "minItems": 1,
                "maxItems": 12,
                "uniqueItems": true
              },
              "kind": {
                "enum": [
                  "password",
                  "token",
                  "authorization",
                  "url-password"
                ]
              },
              "line": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100000
              },
              "offset": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4194304
              },
              "length": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16384
              },
              "masked": {
                "const": "<masked>"
              },
              "value_complete": {
                "type": "boolean"
              },
              "digest": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^sha256:[0-9a-f]{16}$",
                "maxLength": 23
              },
              "confidence": {
                "const": "possible"
              }
            },
            "required": [
              "pattern_ids",
              "kind",
              "line",
              "offset",
              "length",
              "masked",
              "value_complete",
              "digest",
              "confidence"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "value_complete": {
                      "const": false
                    }
                  }
                },
                "then": {
                  "properties": {
                    "digest": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "value_complete": {
                      "const": true
                    }
                  }
                },
                "then": {
                  "properties": {
                    "digest": {
                      "type": "string"
                    }
                  }
                }
              }
            ]
          },
          "minItems": 0,
          "maxItems": 200
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hits": {
              "type": "integer",
              "minimum": 0,
              "maximum": 200
            },
            "by_kind": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "password": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 200
                },
                "token": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 200
                },
                "authorization": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 200
                },
                "url-password": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 200
                }
              },
              "required": [
                "password",
                "token",
                "authorization",
                "url-password"
              ]
            },
            "unique_digest_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 200
            }
          },
          "required": [
            "hits",
            "by_kind",
            "unique_digest_count"
          ]
        },
        "limitations": {
          "const": [
            "heuristic_candidates_only",
            "utf8_only",
            "single_selected_file_only",
            "no_multiline_secrets",
            "no_hash_cracking",
            "no_authentication",
            "no_media_decoding",
            "no_plaintext_output"
          ]
        }
      },
      "required": [
        "schema",
        "status",
        "params",
        "rules",
        "coverage",
        "matches",
        "summary",
        "limitations"
      ]
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target": {
          "$ref": "#/$defs/target"
        },
        "outcome": {
          "enum": [
            "scanned",
            "read_failed"
          ]
        },
        "reason": {
          "enum": [
            null,
            "refs_unverifiable",
            "metadata_unverifiable",
            "incomplete_file",
            "read_failed",
            "time_limit"
          ]
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/fresh_source"
            },
            {
              "type": "null"
            }
          ]
        },
        "scan": {
          "anyOf": [
            {
              "$ref": "#/$defs/scan_result"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "target",
        "outcome",
        "reason",
        "source",
        "scan"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "scanned"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "type": "null"
              },
              "source": {
                "$ref": "#/$defs/fresh_source"
              },
              "scan": {
                "$ref": "#/$defs/scan_result"
              }
            }
          },
          "else": {
            "properties": {
              "reason": {
                "enum": [
                  "refs_unverifiable",
                  "metadata_unverifiable",
                  "incomplete_file",
                  "read_failed",
                  "time_limit"
                ]
              },
              "source": {
                "type": "null"
              },
              "scan": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
