                  "sum16be",
                  "fletcher16",
                  "crc16-ccitt-false",
                  "crc16-xmodem",
                  "crc16-kermit",
                  "crc16-x25",
                  "crc16-modbus",
                  "crc16-arc"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "endian": {
