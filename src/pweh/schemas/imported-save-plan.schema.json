    "checksum": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "endian",
        "location",
        "range",
        "before",
        "after",
        "original_rule_reproduced",
        "patched_rule_reproduced"
      ],
      "properties": {
        "algorithm": {
          "enum": [
            "sum8",
            "negsum8",
            "notsum8",
            "xor8",
            "crc8",
            "crc8-maxim",
            "sum16",
            "sum16le",
            "sum16be",
            "fletcher16",
            "crc16-ccitt-false",
            "crc16-xmodem",
            "crc16-kermit",
            "crc16-x25",
            "crc16-modbus",
            "crc16-arc",
            "sum32",
            "sum32le",
            "sum32be",
            "adler32",
            "crc32",
            "crc32-jamcrc",
            "crc32-mpeg2",
            "crc32-bzip2"
          ]
        },
        "endian": {
          "enum": [
            null,
            "le",
            "be"
          ]
        },
        "location": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8388607
        },
        "range": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 8388607
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 8388608
            }
          ],
          "items": false
        },
        "before": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "after": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "original_rule_reproduced": {
          "const": true
        },
        "patched_rule_reproduced": {
          "const": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "algorithm": {
                "enum": [
                  "sum8",
                  "negsum8",
                  "notsum8",
                  "xor8",
                  "crc8",
                  "crc8-maxim"
                ]
              }
            }
          },
          "then": {
            "properties": {
