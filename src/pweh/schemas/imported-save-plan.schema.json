              },
              "before_value": {
                "type": "integer",
                "minimum": -32768,
                "maximum": 32767
              },
              "after_value": {
                "type": "integer",
                "minimum": -32768,
                "maximum": 32767
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "encoding": {
                "const": "i16be"
              }
            }
          },
          "then": {
            "properties": {
              "offset": {
                "type": "integer",
                "minimum": 0,
                "maximum": 8388606
              },
              "before_value": {
                "type": "integer",
                "minimum": -32768,
                "maximum": 32767
              },
              "after_value": {
                "type": "integer",
                "minimum": -32768,
                "maximum": 32767
              }
            }
          }
        },
        {
          "if": {
