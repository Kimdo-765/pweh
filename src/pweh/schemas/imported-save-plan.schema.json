{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pweh.local/schemas/imported-save-plan.schema.json",
  "title": "가져온 세이브 로컬 변경 계획",
  "description": "가져온 아티팩트와 원장 항목에 결속한 로컬 계획. 장치 쓰기·독립 백업·게임 수용을 확인하지 않는다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile",
    "stage",
    "source",
    "params",
    "edits",
    "checksum",
    "output",
    "device_association_verified",
    "independent_backup_verified",
    "write_address_verified",
    "write_ready",
    "device_written",
    "game_acceptance_verified"
  ],
  "properties": {
    "schema": {
      "const": "pweh.imported-save-plan/v1"
    },
    "profile": {
      "const": "raw-save-local-plan-v1"
    },
    "stage": {
      "const": "planned"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "artifact_id",
        "size",
        "sha256",
        "import_provenance"
      ],
      "properties": {
        "kind": {
          "const": "case-artifact"
        },
        "artifact_id": {
          "type": "string",
          "pattern": "^A-[0-9]{4,8}(?![\\s\\S])",
          "minLength": 6,
          "maxLength": 10
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
          "minLength": 64,
          "maxLength": 64
        },
        "import_provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "seq",
            "record_sha256"
          ],
          "properties": {
            "kind": {
              "const": "imported-unattested"
            },
            "seq": {
              "type": "integer",
              "minimum": 1
            },
            "record_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
              "minLength": 64,
              "maxLength": 64
            }
          }
        }
      }
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offset",
        "length",
        "purpose",
        "unlock_source",
        "online_capable",
        "max_seconds"
      ],
      "properties": {
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8388607
        },
        "length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        },
        "purpose": {
          "enum": [
            "score",
            "progress",
            "in-device-unlock"
          ]
        },
        "unlock_source": {
          "enum": [
            "in-device",
            "owned-tag"
          ]
        },
        "online_capable": {
          "enum": [
            "no",
            "unknown"
          ]
        },
        "max_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 30
        }
      }
    },
    "edits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/edit"
      }
    },
    "checksum": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/checksum"
        }
      ]
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "size",
        "sha256"
      ],
      "properties": {
        "name": {
          "const": "planned.bin"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
          "minLength": 64,
          "maxLength": 64
        }
      }
    },
    "device_association_verified": {
      "const": false
    },
    "independent_backup_verified": {
      "const": false
    },
    "write_address_verified": {
      "const": false
    },
    "write_ready": {
      "const": false
    },
    "device_written": {
      "const": false
    },
    "game_acceptance_verified": {
      "const": false
    }
  },
  "$defs": {
    "edit": {
