{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pweh.local/schemas/media-unit-extract.schema.json",
  "title": "저장 미디어 구조 후보 한 단위의 파생 추출",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "pweh.media-unit-extract/v1"
    },
    "method": {
      "const": "media_unit"
    },
    "status": {
      "enum": [
        "ok",
        "partial"
      ]
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^EV-[0-9]{4,6}$"
    },
    "evidence_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "oneOf": [
        {
          "$ref": "#/$defs/selected_file_source"
        },
        {
          "$ref": "#/$defs/evidence_range_source"
        },
        {
          "$ref": "#/$defs/exfat_residual_source"
        }
      ]
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^forensics/analysis/media-unit-candidates-EV-[0-9]{4,6}-[0-9]{3,9}\\.json$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "custody_seq": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "custody_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256",
        "size",
        "custody_seq",
        "custody_hash"
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108863
        },
        "length": {
          "type": "integer",
          "minimum": 4,
          "maximum": 67108864
        },
        "format": {
          "enum": [
            "jpeg",
            "avc-annexb",
            "mpeg2-ps",
            "xm"
          ]
        },
        "unit": {
          "enum": [
            "jpeg_codestream",
            "avc_nal",
            "mpeg2_ps_pack_prefix",
            "xm_frame"
          ]
        },
        "unit_subtype": {
          "enum": [
            "baseline",
            "nal_1",
            "nal_2",
            "nal_3",
            "nal_4",
            "nal_5",
            "nal_6",
            "nal_7",
            "nal_8",
            "nal_9",
            "nal_10",
            "nal_11",
            "nal_12",
            "mpeg2_pack",
            "type_fc",
            "type_fe",
            "type_fd",
            "type_fa",
            "type_f9"
          ]
        },
        "boundary_kind": {
          "enum": [
            "eoi",
            "next_nal",
            "next_pack",
            "program_end",
            "validated_prefix",
            "declared_length"
          ]
        },
        "framing_status": {
          "enum": [
            "closed",
            "prefix"
          ]
        },
        "end_reason": {
          "enum": [
            "eoi",
            "next_nal",
            "next_pack",
            "program_end",
            "selection_end",
            "truncated_packet",
            "unsupported_packet",
            "invalid_packet",
            "zero_length_packet",
            "declared_length"
          ]
        },
        "confidence": {
          "const": "possible"
        }
      },
      "required": [
        "index",
        "offset",
        "length",
        "format",
        "unit",
        "unit_subtype",
        "boundary_kind",
        "framing_status",
        "end_reason",
        "confidence"
      ],
      "oneOf": [
        {
          "properties": {
            "format": {
              "const": "jpeg"
            },
            "unit": {
              "const": "jpeg_codestream"
            },
            "length": {
              "type": "integer",
              "minimum": 28,
              "maximum": 67108864
            },
            "unit_subtype": {
              "const": "baseline"
            },
            "framing_status": {
              "const": "closed"
            },
            "boundary_kind": {
              "const": "eoi"
            },
            "end_reason": {
              "const": "eoi"
            }
          }
        },
        {
          "properties": {
            "format": {
              "const": "avc-annexb"
            },
            "unit": {
              "const": "avc_nal"
            },
            "length": {
              "type": "integer",
              "minimum": 4,
              "maximum": 67108864
            },
            "unit_subtype": {
              "enum": [
                "nal_1",
                "nal_2",
                "nal_3",
                "nal_4",
                "nal_5",
                "nal_6",
                "nal_7",
                "nal_8",
                "nal_9",
                "nal_10",
                "nal_11",
                "nal_12"
              ]
            },
            "framing_status": {
              "const": "closed"
            },
            "boundary_kind": {
              "const": "next_nal"
            },
            "end_reason": {
              "const": "next_nal"
            }
          }
        },
        {
          "properties": {
            "format": {
              "const": "mpeg2-ps"
            },
            "unit": {
              "const": "mpeg2_ps_pack_prefix"
            },
            "length": {
              "type": "integer",
              "minimum": 24,
              "maximum": 67108864
            },
            "unit_subtype": {
              "const": "mpeg2_pack"
            }
          },
          "oneOf": [
            {
              "properties": {
                "framing_status": {
                  "const": "closed"
                },
                "boundary_kind": {
                  "const": "next_pack"
                },
                "end_reason": {
                  "const": "next_pack"
                }
              }
            },
            {
              "properties": {
                "framing_status": {
                  "const": "closed"
                },
                "boundary_kind": {
                  "const": "program_end"
                },
                "end_reason": {
                  "const": "program_end"
                }
              }
            },
            {
              "properties": {
                "framing_status": {
                  "const": "prefix"
                },
                "boundary_kind": {
                  "const": "validated_prefix"
                },
                "end_reason": {
                  "enum": [
                    "selection_end",
                    "truncated_packet",
                    "unsupported_packet",
                    "invalid_packet",
                    "zero_length_packet"
                  ]
                }
              }
            }
          ]
        },
        {
          "properties": {
            "format": {
              "const": "xm"
            },
            "unit": {
              "const": "xm_frame"
            },
            "length": {
              "type": "integer",
              "minimum": 9,
              "maximum": 67108864
            },
            "unit_subtype": {
              "enum": [
                "type_fc",
                "type_fe",
                "type_fd",
                "type_fa",
                "type_f9"
              ]
            },
            "framing_status": {
              "const": "closed"
            },
            "boundary_kind": {
              "const": "declared_length"
            },
            "end_reason": {
              "const": "declared_length"
            }
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "unit_subtype": {
                "enum": [
                  "type_fc",
                  "type_fe"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "length": {
                "type": "integer",
                "minimum": 17,
                "maximum": 67108864
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "unit_subtype": {
                "enum": [
                  "nal_10",
                  "nal_11"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "length": {
                "enum": [
                  4,
                  5
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "unit_subtype": {
                "enum": [
                  "nal_1",
                  "nal_2",
                  "nal_3",
                  "nal_4",
                  "nal_5",
                  "nal_6",
                  "nal_7",
                  "nal_8",
                  "nal_9",
                  "nal_12"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "length": {
                "type": "integer",
                "minimum": 5,
                "maximum": 67108864
              }
            }
          }
        }
      ]
    },
    "source_status": {
      "enum": [
        "ok",
        "partial"
      ]
    },
    "source_coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_bytes": {
          "type": "integer",
          "minimum": 8,
          "maximum": 67108864
        },
        "search_positions_total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864
        },
        "search_positions_examined": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864
        },
        "unexamined_positions": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 67108864
                },
                "count": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 67108864
                },
                "reason": {
                  "enum": [
                    "probe_limit",
                    "candidate_limit",
                    "step_limit",
                    "work_byte_limit",
                    "output_limit",
                    "time_limit"
                  ]
                }
              },
              "required": [
                "start",
                "count",
                "reason"
              ]
            }
          ]
        },
        "pending_anchor_offset": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 67108863
            }
          ]
        },
        "search_complete": {
          "type": "boolean"
        },
        "candidate_checks_complete": {
          "type": "boolean"
        },
        "candidate_list_complete": {
          "type": "boolean"
        },
        "selection_uncertain": {
          "type": "boolean"
        },
        "container_examined": {
          "const": false
        },
        "anchor_probes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        },
        "structure_steps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8192
        },
        "search_bytes_charged": {
          "type": "integer",
          "minimum": 0,
          "maximum": 134217728
        },
        "structure_bytes_charged": {
          "type": "integer",
          "minimum": 0,
          "maximum": 134217728
        },
        "work_bytes_charged": {
          "type": "integer",
          "minimum": 0,
          "maximum": 134217728
        },
        "reasons": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 10,
          "items": {
            "enum": [
              "probe_limit",
              "candidate_limit",
              "step_limit",
              "work_byte_limit",
              "output_limit",
              "time_limit",
              "unit_framing_incomplete",
              "candidate_prefix_partial",
              "selection_uncertain",
              "container_listing_incomplete"
            ]
          }
        }
      },
      "required": [
        "input_bytes",
        "search_positions_total",
        "search_positions_examined",
        "unexamined_positions",
        "pending_anchor_offset",
        "search_complete",
        "candidate_checks_complete",
        "candidate_list_complete",
        "selection_uncertain",
        "container_examined",
        "anchor_probes",
        "structure_steps",
        "search_bytes_charged",
        "structure_bytes_charged",
        "work_bytes_charged",
        "reasons"
      ]
    },
    "effective_selection_uncertain": {
      "type": "boolean"
    },
    "effective_container_listing_incomplete": {
      "type": "boolean"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "file": {
            "const": "unit-000.bin"
          },
          "size": {
            "type": "integer",
            "minimum": 4,
            "maximum": 67108864
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "complete": {
            "const": true
          }
        },
        "required": [
          "file",
          "size",
          "sha256",
          "complete"
        ]
      }
    },
    "bytes_total": {
      "type": "integer",
      "minimum": 4,
      "maximum": 67108864
    },
    "payload_semantics_examined": {
      "const": false
    },
    "media_decoded": {
      "const": false
    },
    "playback_verified": {
      "const": false
    },
    "recording_time_verified": {
      "const": false
    },
    "encryption_assessed": {
      "const": false
    },
    "original_file_boundary_verified": {
      "const": false
    },
    "complete_recording": {
      "const": false
    },
    "format_conformance_assessed": {
      "const": false
    },
    "format": {
      "enum": [
        "jpeg",
        "avc-annexb",
        "mpeg2-ps",
        "xm"
      ]
    },
    "source_profile": {
      "enum": [
        "jpeg-baseline-marker-v1",
        "avc-annexb-delimited-nal-v1",
        "mpeg2-ps-bounded-pack-prefix-v1",
        "xm-length-delimited-frame-v1",
        "jpeg-baseline-marker-ev-range-v1",
        "avc-annexb-delimited-nal-ev-range-v1",
        "mpeg2-ps-bounded-pack-prefix-ev-range-v1",
        "xm-length-delimited-frame-ev-range-v1",
        "jpeg-baseline-marker-exfat-residual-v1",
        "avc-annexb-delimited-nal-exfat-residual-v1",
        "mpeg2-ps-bounded-pack-prefix-exfat-residual-v1",
        "xm-length-delimited-frame-exfat-residual-v1"
      ]
    }
  },
  "required": [
    "schema",
    "method",
    "status",
    "evidence_id",
    "evidence_sha256",
    "source",
    "analysis",
    "candidate",
    "source_status",
    "source_coverage",
    "effective_selection_uncertain",
    "effective_container_listing_incomplete",
    "files",
    "bytes_total",
    "payload_semantics_examined",
    "media_decoded",
    "playback_verified",
    "recording_time_verified",
    "encryption_assessed",
    "original_file_boundary_verified",
    "complete_recording",
    "format_conformance_assessed",
    "format",
    "source_profile"
  ],
  "allOf": [
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "source_status": {
                "const": "partial"
              }
            }
          },
          {
            "properties": {
              "effective_selection_uncertain": {
                "const": true
              }
            }
          },
          {
            "properties": {
              "effective_container_listing_incomplete": {
                "const": true
              }
            }
          },
          {
            "properties": {
              "candidate": {
                "properties": {
                  "framing_status": {
                    "const": "prefix"
                  }
                }
              }
            }
          }
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "partial"
          }
        }
      },
      "else": {
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "properties": {
          "source_coverage": {
            "properties": {
              "reasons": {
                "maxItems": 0
              },
              "selection_uncertain": {
                "const": false
              },
              "search_complete": {
                "const": true
              },
              "candidate_checks_complete": {
                "const": true
              },
              "candidate_list_complete": {
                "const": true
              },
              "pending_anchor_offset": {
                "type": "null"
              },
              "unexamined_positions": {
                "type": "null"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "source_coverage": {
            "properties": {
              "reasons": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "source_coverage": {
                "properties": {
                  "selection_uncertain": {
                    "const": true
                  }
                }
              }
            }
          },
          {
            "properties": {
              "source": {
                "properties": {
                  "deleted": {
                    "const": true
                  }
                }
              }
            }
          },
          {
            "properties": {
              "source": {
                "properties": {
                  "parent_deleted": {
                    "const": true
                  }
                }
              }
            }
          },
          {
            "properties": {
              "source": {
                "properties": {
                  "confidence": {
                    "not": {
                      "const": "high"
                    }
                  }
                }
              }
            }
          },
          {
            "properties": {
              "source": {
                "properties": {
                  "container": {
                    "const": "filesystem"
                  },
                  "parent_deleted": {
                    "type": "null"
                  }
                }
              }
            }
          }
        ]
      },
      "then": {
        "properties": {
          "effective_selection_uncertain": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "source": {
                "properties": {
                  "container_truncated": {
                    "const": true
                  }
                }
              }
            }
          },
          {
            "properties": {
              "source_coverage": {
                "properties": {
                  "reasons": {
                    "contains": {
                      "const": "container_listing_incomplete"
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "then": {
        "properties": {
          "effective_container_listing_incomplete": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "candidate": {
            "properties": {
              "framing_status": {
                "const": "prefix"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "source_status": {
            "const": "partial"
          },
          "source_coverage": {
            "properties": {
              "reasons": {
                "contains": {
                  "const": "candidate_prefix_partial"
                }
              }
            }
          }
        }
      }
    },
    {
      "oneOf": [
        {
          "properties": {
            "format": {
              "const": "jpeg"
            },
            "source_profile": {
              "const": "jpeg-baseline-marker-v1"
            },
            "source": {
              "allOf": [
                {
                  "$ref": "#/$defs/selected_file_source"
                },
                {
                  "properties": {
                    "selected_size": {
                      "minimum": 28
                    }
                  }
                }
              ]
            },
            "candidate": {
              "properties": {
                "format": {
                  "const": "jpeg"
                }
              }
            },
            "files": {
              "items": {
                "properties": {
                  "size": {
                    "minimum": 28
                  }
                }
              }
            },
            "bytes_total": {
              "minimum": 28
            }
          }
        },
        {
          "properties": {
            "format": {
              "const": "jpeg"
            },
            "source_profile": {
              "const": "jpeg-baseline-marker-ev-range-v1"
            },
            "source": {
              "allOf": [
                {
                  "$ref": "#/$defs/evidence_range_source"
                },
                {
                  "properties": {
                    "selected_size": {
                      "minimum": 28
                    }
                  }
                }
              ]
            },
            "candidate": {
              "properties": {
                "format": {
                  "const": "jpeg"
                }
              }
            },
            "files": {
              "items": {
                "properties": {
                  "size": {
                    "minimum": 28
                  }
                }
              }
            },
            "bytes_total": {
              "minimum": 28
            }
          }
        },
        {
          "properties": {
            "format": {
              "const": "avc-annexb"
            },
            "source_profile": {
              "const": "avc-annexb-delimited-nal-v1"
            },
            "source": {
              "allOf": [
                {
                  "$ref": "#/$defs/selected_file_source"
                },
                {
                  "properties": {
                    "selected_size": {
                      "minimum": 8
                    }
                  }
                }
              ]
            },
            "candidate": {
              "properties": {
                "format": {
                  "const": "avc-annexb"
                }
              }
            },
            "files": {
              "items": {
                "properties": {
                  "size": {
                    "minimum": 4
                  }
                }
              }
            },
            "bytes_total": {
              "minimum": 4
            }
          }
        },
        {
          "properties": {
            "format": {
              "const": "avc-annexb"
            },
            "source_profile": {
              "const": "avc-annexb-delimited-nal-ev-range-v1"
            },
            "source": {
              "allOf": [
                {
                  "$ref": "#/$defs/evidence_range_source"
                },
                {
                  "properties": {
                    "selected_size": {
                      "minimum": 8
                    }
                  }
                }
              ]
            },
            "candidate": {
              "properties": {
                "format": {
                  "const": "avc-annexb"
                }
              }
            },
            "files": {
              "items": {
                "properties": {
                  "size": {
                    "minimum": 4
                  }
                }
              }
            },
            "bytes_total": {
              "minimum": 4
            }
          }
        },
        {
          "properties": {
            "format": {
              "const": "mpeg2-ps"
            },
            "source_profile": {
              "const": "mpeg2-ps-bounded-pack-prefix-v1"
            },
            "source": {
              "allOf": [
                {
                  "$ref": "#/$defs/selected_file_source"
                },
                {
                  "properties": {
                    "selected_size": {
                      "minimum": 24
                    }
                  }
                }
              ]
            },
            "candidate": {
              "properties": {
                "format": {
                  "const": "mpeg2-ps"
                }
