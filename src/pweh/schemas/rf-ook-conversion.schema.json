{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pweh.rf-ook-conversion/v1",
  "title": "등록 RAW의 제한된 OOK 변환 매니페스트",
  "type": "object",
  "required": [
    "schema",
    "profile",
    "status",
    "source",
    "params",
    "metadata",
    "conversion",
    "output",
    "input_completeness_verified",
    "capture_verified",
    "device_association_verified",
    "authorization_assessed",
    "decoded",
    "transmitted",
    "packet_boundaries_verified",
    "decoder_compatibility_verified",
    "limitations"
  ],
  "properties": {
    "schema": {
      "const": "pweh.rf-ook-conversion/v1"
    },
    "profile": {
      "const": "flipper-raw-ook-v1"
    },
    "status": {
      "const": "complete"
    },
    "source": {
      "type": "object",
      "required": [
        "kind",
        "artifact_id",
        "size",
        "sha256"
      ],
      "properties": {
        "kind": {
          "const": "case-artifact"
        },
        "artifact_id": {
          "type": "string",
          "pattern": "^A-[0-9]{4,8}$(?![\\s\\S])"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
        }
      },
      "additionalProperties": false
    },
    "params": {
      "type": "object",
      "required": [
        "source_profile",
        "max_seconds"
      ],
      "properties": {
        "source_profile": {
          "const": "flipper-subghz-raw-v1-strict"
        },
        "max_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 5
        }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "required": [
        "declared_preset",
        "declared_frequency_hz"
      ],
      "properties": {
        "declared_preset": {
          "enum": [
            "FuriHalSubGhzPresetOok270Async",
            "FuriHalSubGhzPresetOok650Async"
          ]
        },
        "declared_frequency_hz": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "additionalProperties": false
    },
    "conversion": {
      "type": "object",
      "required": [
        "format",
        "unit",
        "pairing",
        "duration_count",
        "pair_count",
        "total_duration_us"
      ],
      "properties": {
        "format": {
          "const": "rtl433-ook-text-v1"
        },
        "unit": {
          "const": "us"
        },
        "pairing": {
          "const": "positive-negative"
        },
        "duration_count": {
          "type": "integer",
          "minimum": 2,
          "maximum": 2400
        },
        "pair_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1200
        },
        "total_duration_us": {
          "type": "integer",
          "minimum": 2,
          "maximum": 5153960752800
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": [
        "path",
        "size",
        "sha256"
      ],
      "properties": {
        "path": {
          "enum": [
            "analysis/rf-ook-001/converted.ook",
            "analysis/rf-ook-002/converted.ook",
            "analysis/rf-ook-003/converted.ook",
            "analysis/rf-ook-004/converted.ook",
            "analysis/rf-ook-005/converted.ook",
