              "minimum": 0,
              "maximum": 1024
            },
            "unsupported_extension": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1024
            },
            "multiple_scans": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1024
            },
            "zero_length_packet": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1024
            }
          },
          "required": [
            "unsupported_variant",
            "unsupported_extension",
            "multiple_scans",
            "zero_length_packet"
