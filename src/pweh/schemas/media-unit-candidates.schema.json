            "invalid_length": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1024
            },
            "invalid_sequence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1024
            },
            "invalid_escape": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1024
            },
