{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pweh.nfc-analysis/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "mode",
    "tags",
    "results",
    "physical_same_tag_verified",
    "tag_content_written",
    "authentication_attempted",
    "emulation_performed"
  ],
  "properties": {
    "schema": {
      "const": "pweh.nfc-analysis/v1"
    },
    "mode": {
      "enum": [
        "scan-bound-offline",
        "cu-hf-identify"
      ]
    },
    "tags": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tag_ref",
          "scan_ref",
          "family",
          "identity_digest"
        ],
        "properties": {
          "tag_ref": {
            "type": "string",
            "pattern": "^NT-[0-9a-f]{32}$"
          },
          "scan_ref": {
            "type": "string",
            "pattern": "^NS-[0-9a-f]{32}$"
          },
          "family": {
            "enum": [
              "ntag213",
              "ntag215",
              "ntag216"
            ]
          },
          "identity_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{16}$"
          }
        }
      }
    },
    "results": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "path",
          "sha256",
          "operation",
          "status",
          "tag_ref"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^A-[0-9]{4,8}$"
          },
          "path": {
            "type": "string",
            "pattern": "^analysis/nfc-(file|diff)-[0-9]{3,5}\\.json$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "operation": {
            "enum": [
              "inspect",
              "diff"
            ]
          },
          "status": {
            "enum": [
              "ok",
              "partial",
              "malformed",
              "unsupported"
            ]
          },
          "tag_ref": {
            "type": "string",
            "pattern": "^NT-[0-9a-f]{32}$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "operation": {
                  "const": "inspect"
                }
              }
            },
            "then": {
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^analysis/nfc-file-[0-9]{3,5}\\.json$"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "operation": {
                  "const": "diff"
                }
              }
            },
            "then": {
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^analysis/nfc-diff-[0-9]{3,5}\\.json$"
                }
              }
            }
          }
        ]
      }
    },
    "physical_same_tag_verified": {
      "const": false
    },
    "tag_content_written": {
      "const": false
    },
    "authentication_attempted": {
      "const": false
    },
    "emulation_performed": {
      "const": false
    },
    "identifications": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "profile",
          "family",
          "policy",
          "uid_length",
          "ats_present",
          "get_version_sent",
          "page_reads_sent",
          "identity_digest"
        ],
        "properties": {
          "operation": {
            "const": "cu-identify"
          },
          "profile": {
            "const": "cu-hf14a-identify-v2.3.0-v1"
          },
          "family": {
            "enum": [
              "iso14443_4",
              "mifare_classic_1k",
              "mifare_classic_2k",
              "mifare_classic_4k",
              "mifare_classic_mini",
              "mifare_classic_tnp3xxx",
              "mifare_plus_sl2",
              "multiple",
              "none",
              "ntag213",
              "ntag215",
              "ntag216",
              "other",
              "type2_other_version",
              "type2_version_unreadable",
              "ultralight_ev1_mf0ul11",
              "ultralight_ev1_mf0ul21",
              "ultralight_ev1_mf0ulh11",
              "ultralight_ev1_mf0ulh21",
              "ultralight_or_ultralight_c"
            ]
          },
          "policy": {
            "enum": [
              "allowed",
              "attestation_required",
              "not_applicable",
              "refused"
            ]
          },
          "uid_length": {
            "enum": [
              null,
              4,
              7,
              10
            ]
          },
          "ats_present": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "get_version_sent": {
            "type": "boolean"
          },
          "page_reads_sent": {
            "const": false
          },
          "identity_digest": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{16}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "device_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "battery_mv",
        "battery_percent",
        "battery_percent_is_estimate",
        "active_slot",
        "mode",
        "hf14a_config_default",
        "app_version",
        "git_version",
        "model"
      ],
      "properties": {
        "battery_mv": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "battery_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "battery_percent_is_estimate": {
          "const": true
        },
        "active_slot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "mode": {
          "const": "reader"
        },
        "hf14a_config_default": {
          "type": "boolean"
        },
        "app_version": {
          "const": "2.3"
        },
        "git_version": {
          "const": "v2.3.0"
        },
        "model": {
          "const": "chameleon-ultra"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "scan-bound-offline"
          }
        }
      },
      "then": {
        "properties": {
          "tags": {
            "minItems": 1
          }
        },
        "not": {
          "required": [
            "identifications"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "cu-hf-identify"
          }
        }
      },
      "then": {
        "required": [
          "identifications"
        ]
      }
    }
  ]
}
