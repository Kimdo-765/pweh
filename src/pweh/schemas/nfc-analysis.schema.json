{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pweh.nfc-analysis/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "mode",
    "tags",
    "results",
    "physical_same_tag_verified",
    "tag_content_written",
    "authentication_attempted",
    "emulation_performed"
  ],
  "properties": {
    "schema": {
      "const": "pweh.nfc-analysis/v1"
    },
    "mode": {
      "enum": [
        "scan-bound-offline",
        "cu-hf-identify",
        "cu-lf-identify"
      ]
    },
    "tags": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tag_ref",
              "scan_ref",
              "family",
              "identity_digest"
            ],
            "properties": {
              "tag_ref": {
                "type": "string",
                "pattern": "^NT-[0-9a-f]{32}$"
              },
              "scan_ref": {
                "type": "string",
                "pattern": "^NS-[0-9a-f]{32}$"
              },
              "family": {
                "enum": [
                  "ntag213",
                  "ntag215",
                  "ntag216"
                ]
              },
              "identity_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{16}$"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tag_ref",
              "scan_ref",
              "family",
              "ul_identity_digest",
              "tag_ownership_attestation_id"
            ],
            "properties": {
              "tag_ref": {
                "type": "string",
                "pattern": "^UT-[0-9a-f]{32}$"
              },
              "scan_ref": {
                "type": "string",
                "pattern": "^US-[0-9a-f]{32}$"
              },
              "family": {
                "enum": [
                  "ultralight_ev1_mf0ul11",
                  "ultralight_ev1_mf0ulh11",
                  "ultralight_ev1_mf0ul21",
                  "ultralight_ev1_mf0ulh21",
                  "ultralight_or_ultralight_c"
                ]
              },
              "ul_identity_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{16}$"
              },
              "tag_ownership_attestation_id": {
                "type": "string",
                "pattern": "^att-[0-9a-f]{10}$"
              }
            }
          }
        ]
      }
    },
    "results": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifact_id",
              "path",
              "sha256",
              "operation",
              "status",
              "tag_ref"
            ],
            "properties": {
              "artifact_id": {
                "type": "string",
                "pattern": "^A-[0-9]{4,8}$"
              },
              "path": {
                "type": "string",
                "pattern": "^analysis/nfc-(file|diff)-[0-9]{3,5}\\.json$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "operation": {
                "enum": [
                  "inspect",
                  "diff"
                ]
              },
              "status": {
                "enum": [
                  "ok",
                  "partial",
                  "malformed",
                  "unsupported"
                ]
              },
              "tag_ref": {
                "type": "string",
                "pattern": "^NT-[0-9a-f]{32}$"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "operation": {
                      "const": "inspect"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "path": {
                      "type": "string",
                      "pattern": "^analysis/nfc-file-[0-9]{3,5}\\.json$"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "operation": {
                      "const": "diff"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "path": {
                      "type": "string",
                      "pattern": "^analysis/nfc-diff-[0-9]{3,5}\\.json$"
                    }
                  }
                }
              }
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifact_id",
              "path",
              "sha256",
              "operation",
              "status",
              "tag_ref"
            ],
            "properties": {
              "artifact_id": {
                "type": "string",
                "pattern": "^A-[0-9]{4,8}$"
              },
              "path": {
                "type": "string",
                "pattern": "^analysis/nfc-ul-(file|diff)-[0-9]{3,5}\\.json$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "operation": {
                "enum": [
                  "inspect",
                  "diff"
                ]
              },
              "status": {
                "enum": [
                  "ok",
                  "partial"
                ]
              },
              "tag_ref": {
                "type": "string",
                "pattern": "^UT-[0-9a-f]{32}$"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "operation": {
                      "const": "inspect"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "path": {
                      "type": "string",
                      "pattern": "^analysis/nfc-ul-file-[0-9]{3,5}\\.json$"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "operation": {
                      "const": "diff"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "path": {
                      "type": "string",
                      "pattern": "^analysis/nfc-ul-diff-[0-9]{3,5}\\.json$"
                    }
                  }
                }
              }
            ]
          }
        ]
      }
    },
    "physical_same_tag_verified": {
      "const": false
    },
    "tag_content_written": {
      "const": false
    },
    "authentication_attempted": {
      "const": false
    },
    "emulation_performed": {
      "const": false
    },
    "identifications": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "profile",
          "family",
          "policy",
          "uid_length",
          "ats_present",
          "get_version_sent",
          "page_reads_sent",
          "identity_digest"
        ],
        "properties": {
          "operation": {
            "const": "cu-identify"
          },
          "profile": {
            "const": "cu-hf14a-identify-v2.3.0-v1"
          },
          "family": {
            "enum": [
              "iso14443_4",
              "mifare_classic_1k",
              "mifare_classic_2k",
              "mifare_classic_4k",
              "mifare_classic_mini",
              "mifare_classic_tnp3xxx",
              "mifare_plus_sl2",
              "multiple",
              "none",
              "ntag213",
              "ntag215",
              "ntag216",
              "other",
              "type2_other_version",
              "type2_version_unreadable",
              "ultralight_ev1_mf0ul11",
              "ultralight_ev1_mf0ul21",
              "ultralight_ev1_mf0ulh11",
              "ultralight_ev1_mf0ulh21",
              "ultralight_or_ultralight_c"
            ]
          },
          "policy": {
            "enum": [
              "allowed",
              "attestation_required",
              "not_applicable",
              "refused"
            ]
          },
          "uid_length": {
            "enum": [
              null,
              4,
              7,
              10
            ]
          },
          "ats_present": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "get_version_sent": {
            "type": "boolean"
          },
          "page_reads_sent": {
            "const": false
          },
          "identity_digest": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{16}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "lf_identifications": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "profile",
          "family",
          "variant",
          "policy",
          "scans_sent",
          "identity_digest",
          "id_returned"
        ],
        "properties": {
          "operation": {
            "const": "cu-lf-identify"
          },
          "profile": {
            "const": "cu-lf125-identify-v2.3.0-v1"
          },
          "family": {
            "enum": [
              "em410x",
              "hidprox",
              "ioprox",
              "jablotron",
              "none",
              "pac",
              "pyramid",
              "viking"
            ]
          },
          "variant": {
            "enum": [
              null,
              "em410x_16",
              "em410x_32",
              "em410x_64",
              "em410x_electra"
            ]
          },
          "policy": {
            "enum": [
              "not_applicable",
              "refused"
            ]
          },
          "scans_sent": {
            "type": "array",
            "minItems": 1,
            "maxItems": 7,
            "uniqueItems": true,
            "prefixItems": [
              {
                "const": "em410x_scan"
              },
              {
                "const": "hidprox_scan"
              },
              {
                "const": "ioprox_scan"
              },
              {
                "const": "viking_scan"
              },
              {
                "const": "pac_scan"
              },
              {
                "const": "jablotron_scan"
              },
              {
                "const": "pyramid_scan"
              }
            ],
            "items": {
              "enum": [
                "em410x_scan",
                "hidprox_scan",
                "ioprox_scan",
                "viking_scan",
                "pac_scan",
                "jablotron_scan",
                "pyramid_scan"
              ]
            }
          },
          "identity_digest": {
            "type": "null"
          },
          "id_returned": {
            "const": false
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "family": {
                  "const": "em410x"
                }
              }
            },
            "then": {
              "properties": {
                "variant": {
                  "enum": [
                    "em410x_16",
                    "em410x_32",
                    "em410x_64",
                    "em410x_electra"
                  ]
                }
              }
            },
            "else": {
              "properties": {
                "variant": {
                  "const": null
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "family": {
                  "const": "none"
                }
              }
            },
            "then": {
              "properties": {
                "policy": {
                  "const": "not_applicable"
                }
              }
            },
            "else": {
              "properties": {
                "policy": {
                  "const": "refused"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "family": {
                  "const": "em410x"
                }
              }
            },
            "then": {
              "properties": {
                "scans_sent": {
                  "minItems": 1,
                  "maxItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "family": {
                  "const": "hidprox"
                }
              }
            },
            "then": {
              "properties": {
                "scans_sent": {
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "family": {
                  "const": "ioprox"
                }
              }
            },
            "then": {
              "properties": {
                "scans_sent": {
                  "minItems": 3,
                  "maxItems": 3
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "family": {
                  "const": "viking"
                }
              }
            },
            "then": {
              "properties": {
                "scans_sent": {
                  "minItems": 4,
                  "maxItems": 4
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "family": {
                  "const": "pac"
                }
              }
            },
            "then": {
              "properties": {
                "scans_sent": {
                  "minItems": 5,
                  "maxItems": 5
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "family": {
                  "const": "jablotron"
                }
              }
            },
            "then": {
              "properties": {
                "scans_sent": {
                  "minItems": 6,
                  "maxItems": 6
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "family": {
                  "const": "pyramid"
                }
              }
            },
            "then": {
              "properties": {
                "scans_sent": {
                  "minItems": 7,
                  "maxItems": 7
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "family": {
                  "const": "none"
                }
              }
            },
            "then": {
              "properties": {
                "scans_sent": {
                  "minItems": 7,
                  "maxItems": 7
                }
              }
            }
          }
        ]
      }
    },
    "device_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "battery_mv",
        "battery_percent",
        "battery_percent_is_estimate",
        "active_slot",
        "mode",
        "hf14a_config_default",
        "app_version",
        "git_version",
        "model"
      ],
      "properties": {
        "battery_mv": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "battery_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "battery_percent_is_estimate": {
          "const": true
        },
        "active_slot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "mode": {
          "const": "reader"
        },
        "hf14a_config_default": {
          "type": "boolean"
        },
        "app_version": {
          "const": "2.3"
        },
        "git_version": {
          "const": "v2.3.0"
        },
        "model": {
          "const": "chameleon-ultra"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "scan-bound-offline"
          }
        }
      },
      "then": {
        "properties": {
          "tags": {
            "minItems": 1
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "identifications"
              ]
            },
            {
              "required": [
                "lf_identifications"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "cu-hf-identify"
          }
        }
      },
      "then": {
        "required": [
          "identifications"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "cu-lf-identify"
          }
        }
      },
      "then": {
        "required": [
          "lf_identifications"
        ]
      }
    }
  ]
}
