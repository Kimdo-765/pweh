{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pweh.nfc-analysis/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "mode",
    "tags",
    "results",
    "physical_same_tag_verified",
    "tag_content_written",
    "authentication_attempted",
    "emulation_performed"
  ],
  "properties": {
    "schema": {
      "const": "pweh.nfc-analysis/v1"
    },
    "mode": {
      "const": "scan-bound-offline"
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tag_ref",
          "scan_ref",
          "family",
          "identity_digest"
        ],
        "properties": {
          "tag_ref": {
            "type": "string",
            "pattern": "^NT-[0-9a-f]{32}$"
          },
          "scan_ref": {
            "type": "string",
            "pattern": "^NS-[0-9a-f]{32}$"
          },
          "family": {
            "enum": [
              "ntag213",
              "ntag215",
              "ntag216"
            ]
          },
          "identity_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{16}$"
          }
        }
      }
    },
    "results": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "path",
          "sha256",
          "operation",
          "status",
          "tag_ref"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^A-[0-9]{4,8}$"
          },
          "path": {
            "type": "string",
            "pattern": "^analysis/nfc-(file|diff)-[0-9]{3,5}\\.json$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "operation": {
            "enum": [
              "inspect",
              "diff"
            ]
          },
          "status": {
            "enum": [
              "ok",
              "partial",
              "malformed",
              "unsupported"
            ]
          },
          "tag_ref": {
            "type": "string",
            "pattern": "^NT-[0-9a-f]{32}$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "operation": {
                  "const": "inspect"
                }
              }
            },
            "then": {
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^analysis/nfc-file-[0-9]{3,5}\\.json$"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "operation": {
                  "const": "diff"
                }
              }
            },
            "then": {
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^analysis/nfc-diff-[0-9]{3,5}\\.json$"
                }
              }
            }
          }
        ]
      }
    },
    "physical_same_tag_verified": {
      "const": false
    },
    "tag_content_written": {
      "const": false
    },
    "authentication_attempted": {
      "const": false
    },
    "emulation_performed": {
      "const": false
    }
  }
}
