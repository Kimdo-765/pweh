{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pweh.local/schemas/sd-forensics.schema.json",
  "title": "sd-card-forensics 요약 data",
  "description": "카메라·블랙박스 SD 카드 이미지의 증거 분석(접수·해시·보관 기록·파일 시스템·삭제 파일)과 보안 분석(펌웨어의 SD 공격 표면·부팅 로그의 SD 이벤트) 요약. 영상·음성 내용은 열지 않는다. 정지 그림은 forensics_image_hints의 미리보기·OCR만 허용하며 image-hints-analysis 요약으로 기록한다. privacy의 기존 네 값은 false이고 정지 이미지 반환 여부를 별도 필드로 기록한다. 잘림·불완전(forensics_fs_list·forensics_image_check·forensics_extract 의 truncated·truncated_reasons, 해석하지 못한 볼륨 call.volumes_failed, 검증하지 못한 디렉터리 unvalidated_dirs)과 사람이 읽는 상태 표시(status_label)는 이 스키마에 필드가 없다 — notes 에 적는다(그때 filesystems·contamination·recovered 는 본 범위만의 값이다). 선택한 텍스트의 비밀값 후보 검사는 secret_scan_results에 원문 없이 기록한다. 보고서 이름 대조는 ioc_scan_results에 원시 경로·이름 없이 기록하며 실행·침해를 판정하지 않는다. 선택 미디어 구조는 media_inventory_results에 결과 참조만 기록하며 영상·음성을 해독하지 않는다. 저장된 후보의 prefix 추출은 recovered에 합산하고 부분 상태·한계를 notes에 적는다. prefix 작성 완료는 녹화 전체 복구가 아니다. 저장 목록 자동 비밀값 검사는 secret_survey_results에 원문 없이 참조하고, whole_card_examined=false와 미검사 수를 유지한다.",
  "type": "object",
  "required": [
    "mode",
    "privacy"
  ],
  "properties": {
    "mode": {
      "enum": [
        "evidence",
        "security",
        "both"
      ],
      "description": "evidence = 카드 이미지 증거 분석, security = 펌웨어가 SD 카드를 다루는 방식(카드 불필요), both = 둘 다"
    },
    "card": {
      "type": "object",
      "description": "카드와 카드를 꺼낸 기기 (사람이 알려 준 값)",
      "properties": {
        "source_device": {
          "type": [
            "string",
            "null"
          ],
          "description": "카드를 꺼낸 기기의 제조사·모델"
        },
        "capacity": {
          "type": [
            "string",
            "null"
          ],
          "description": "예: 64 GB microSDXC"
        },
        "removed_at": {
          "type": [
            "string",
            "null"
          ],
          "description": "분리 시각(호스트 시계 기준, 시간대 포함)"
        },
        "device_clock_offset": {
          "type": [
            "string",
            "null"
          ],
          "description": "장치 시계 - 호스트 시계 (예: '+00:03:12', 모르면 null)"
        }
      }
    },
    "legal": {
      "type": "object",
      "description": "접수 때 기록한 값 (forensics_intake_start). 적용 법률이 설치 장소 유형·역할에 따라 다르다 — 법률 자문이 아니다",
      "required": [
        "site_type",
        "role",
        "legal_basis"
      ],
      "properties": {
        "site_type": {
          "enum": [
            "home",
            "public",
            "business",
            "vehicle",
            "mobile-business",
            "unknown"
          ]
        },
        "role": {
          "enum": [
            "owner",
            "processor",
            "investigator",
            "other"
          ]
        },
        "legal_basis": {
          "type": "string",
          "minLength": 3
        },
        "purpose": {
          "type": "string"
        }
      }
    },
    "custody_ok": {
      "type": "boolean",
      "description": "보관 기록 체인과 보호 위치 고정점 대조 결과 (forensics_evidence_list 의 custody.ok). true 여도 record-without-intake 항목이 있으면(특히 custody.count 가 0 일 때 — 보관 기록과 고정점을 함께 잃었을 수 있다) notes 에 적고 사람에게 알린다"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "status"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^EV-\\d{4,6}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": [
              "ok",
              "unverified",
              "integrity-failed",
              "missing",
              "record-invalid",
              "custody-broken",
              "record-without-intake",
              "intake-in-progress"
            ],
            "description": "forensics_evidence_list 의 items[].status 값 그대로다(사람이 읽는 status_label 이 아니다 — 'missing (integrity-failed)' 는 status 'missing' 으로 적고 무결성 실패 기록은 notes 에). ok = 마지막 검증(접수 때 사본 재해시 또는 전체 재해시)이 일치, unverified = 접수만(사본 재해시·전체 재해시 없음), integrity-failed = 무결성 실패(빠른 지문·접수 기록 대조·재해시 불일치 — 되돌리지 않는다), missing = 보관 기록에는 접수가 있는데 실제 EV 디렉터리가 없음(지워졌거나 링크·파일로 바뀜 — 링크·파일이면 무결성 실패 unsafe-path 도 기록돼 status_label 이 'missing (integrity-failed)'), record-invalid = 접수 기록 파일이 없거나 읽을 수 없음, custody-broken = 보관 기록 체인·고정점이 깨짐(해시 없음), record-without-intake = 보관 기록에 intake 사건이 없는 EV 디렉터리(해시 없음 — 중단된 접수의 흔적(잡은 쪽이 없는 접수 잠금·*.partial·빈 디렉터리)이 있으면 다음 접수·서버 시작 때 aborted-intakes/ 로 옮겨지고, 흔적이 없으면(보관 기록과 고정점을 함께 잃은 증거, 사람이 만든 디렉터리 등) 사람이 판단할 때까지 그대로 남는다), intake-in-progress = 접수 job 이 그 디렉터리의 접수 잠금을 잡고 있음(해시 없음)"
          },
          "imaging_log": {
            "enum": [
              "match",
              "mismatch",
              "no-hashes",
              "none"
            ],
            "description": "이미징 도구 로그의 해시 대조 (items[].imaging_log.status, none = 로그를 받지 않음)"
          },
          "write_blocker": {
            "enum": [
              "approved",
              "denied",
              "revoked",
              "expired",
              "invalid",
              "none"
            ],
            "description": "사람 증명(write-blocker)의 지금 상태 (items[].attestation.status — 증명 저장소에서 읽은 지금 상태라 철회·만료가 바로 보인다) — 증명 레코드의 대상(증거 id·sha256·크기)이 이 항목과 같을 때만. invalid = 레코드를 믿을 수 없음, none = 증명 없음(attestation 이 null)"
          }
        },
        "description": "forensics_evidence_list 의 items 한 줄. sha256·size 는 보관 기록의 intake 사건(고정점으로 보호됨) 값이다 — 보관 기록에 커밋한 접수가 있는 상태(ok·unverified·integrity-failed·missing·record-invalid)에서만 있다.",
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "ok",
                    "unverified",
                    "integrity-failed",
                    "missing",
                    "record-invalid"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "sha256"
              ]
            }
          }
        ]
      }
    },
    "filesystems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "fs"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^EV-\\d{4,6}$"
          },
          "partition": {
            "type": [
              "integer",
              "null"
            ],
            "description": "forensics_partitions 의 index (파티션 표가 없으면 null)"
          },
          "fs": {
            "enum": [
              "fat12",
              "fat16",
              "fat32",
              "exfat",
              "ext4",
              "ntfs",
              "other",
              "unknown"
            ]
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          },
          "dirty": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "깨끗하지 않게 분리된 흔적(FAT 상태 비트·exFAT VolumeDirty). 카메라가 남기기도 하므로 단독 증거가 아니다"
          },
          "files": {
            "type": "integer",
            "minimum": 0
          },
          "deleted": {
            "type": "integer",
            "minimum": 0
          },
          "time_basis": {
            "enum": [
              "local-unknown-tz",
              "local+offset",
              "utc",
              "mixed",
              "unknown"
            ]
          },
          "time_range": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "first": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "last": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "device_timezone": {
      "type": "object",
      "description": "장치 시간대는 기본값이 없다 — 근거가 있을 때만 가정으로 적는다",
      "properties": {
        "assumed": {
          "type": [
            "string",
            "null"
          ],
          "description": "예: 'UTC+09:00' (근거 없으면 null)"
        },
        "basis": {
          "type": [
            "string",
            "null"
          ],
          "description": "예: 'fstab tz=', 'init 스크립트 TZ', 'DHAV 프레임 시각 비교'"
        }
      }
    },
    "contamination": {
      "type": "array",
      "description": "forensics_image_check 의 호스트 오염 흔적 (volumes[].indicators — path 는 싣지 않는다). 비어 있어도 그 호출이 truncated 면(truncated_reasons·해석하지 못한 볼륨) '흔적 없음'이 아니다 — 본 범위만이라는 것과 사유를 notes 에. 본 볼륨(error 가 아닌 volumes[] 항목)이 하나도 없으면(지원하는 FAT/exFAT 파티션이 없거나 파티션이 이미지 끝 너머) truncated 와 상관없이 '보지 못함'이다",
      "items": {
        "type": "object",
        "required": [
          "indicator",
          "strength"
        ],
        "properties": {
          "evidence_id": {
            "type": "string"
          },
          "indicator": {
            "type": "string"
          },
          "strength": {
            "enum": [
              "strong",
              "weak",
              "ambiguous"
            ]
          }
        }
      }
    },
    "recovered": {
      "type": "object",
      "description": "forensics_extract·forensics_extract_media_candidate 산출물 요약 (forensics/recovered/ — 내용은 열지 않는다). forensics_evidence_list 의 derived[] 중 보관 기록과 맞는(custody recorded) 매니페스트의 합계다. 추출이 partial 또는 truncated 였거나(truncated_reasons·skipped) derived 가 recorded 가 아니면 notes 에",
      "properties": {
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "manifests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "security": {
      "type": "object",
      "properties": {
        "sd_surface_result": {
          "type": [
            "string",
            "null"
          ],
          "description": "fw_sd_surface 결과 JSON (케이스 상대 경로)"
        },
        "checks_found": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^SD-0[1-9]$"
          }
        },
        "sd_events_summary": {
          "type": [
            "object",
            "null"
          ],
          "description": "uart_capture_boot 의 sd_summary (새 빈 시험 카드로 관찰했을 때)"
        },
        "card_matches_firmware_paths": {
          "type": [
            "array",
            "null"
          ],
          "description": "기존 수동 대조 요약의 호환 필드. 이름 일치는 내용·실행·침해 증명이 아니다. 새 자동 대조는 원시 경로를 복사하지 않고 ioc_scan_results에 기록한다.",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "privacy": {
      "type": "object",
      "required": [
        "audio_decoded",
        "face_plate_processing",
        "uploads",
        "recording_content_viewed"
      ],
      "properties": {
        "audio_decoded": {
          "const": false
        },
        "face_plate_processing": {
          "const": false,
          "description": "얼굴 신원 식별·번호판 조회 등 별도 식별 처리. 정지 그림의 일반 OCR은 still_image_ocr_returned로 기록한다."
        },
        "uploads": {
          "const": false,
          "description": "외부 OCR 서비스·제3자 제공 업로드. 허용된 MCP 이미지 콘텐츠 전달은 still_image_content_viewed로 기록한다."
        },
        "recording_content_viewed": {
          "const": false,
          "description": "영상·음성 녹화 내용의 열람. 정지 그림은 still_image_content_viewed로 구분한다."
        },
        "still_image_content_viewed": {
          "type": "boolean",
          "description": "forensics_image_hints의 정규화 미리보기를 모델이 확인했는지. 생략은 기존 요약과의 호환을 위한 것이며 새 분석은 명시한다."
        },
        "still_image_ocr_returned": {
          "type": "boolean",
          "description": "정지 이미지의 마스킹하지 않은 OCR 문구가 반환되었는지."
        },
        "secret_plaintext_returned": {
          "const": false,
          "description": "비밀값 후보는 위치·고정 마스킹·케이스 솔트 지문만 반환한다. 선택 검사 수행 시 false를 명시한다."
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "image_hint_results": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "정지 이미지 분석 JSON 경로. 내용·가설·시각 관찰은 별도의 image-hints summary에 기록한다."
    },
    "secret_scan_results": {
      "type": "array",
      "maxItems": 200,
      "description": "forensics_scan_secrets 결과 참조와 실제 검사 범위. 후보 수는 자격증명 유효성·침해·안전을 뜻하지 않는다. 비밀 원문과 원래 파일명·키 이름은 싣지 않는다.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "analysis_path",
          "analysis_sha256",
          "status",
          "hits",
          "scanned_bytes",
          "unscanned_bytes",
          "reasons"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^EV-\\d{4,6}$"
          },
          "analysis_path": {
            "type": "string",
            "pattern": "^forensics/analysis/secrets-scan-EV-\\d{4,6}-\\d+\\.json$"
          },
          "analysis_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "status": {
            "enum": [
              "ok",
              "partial",
              "unsupported"
            ]
          },
          "hits": {
            "type": "integer",
            "minimum": 0,
            "maximum": 200
          },
          "scanned_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4194304
          },
          "unscanned_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4194304
          },
          "reasons": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "enum": [
                "line_too_long",
                "line_limit",
                "hit_limit",
                "range_limit",
                "output_limit",
                "time_limit",
                "selection_uncertain",
                "container_listing_incomplete",
                "unsupported_media",
                "invalid_utf8",
                "unsupported_encoding",
                "unsupported_unicode"
              ]
            }
          }
        }
      }
    },
    "ioc_scan_results": {
      "type": "array",
      "maxItems": 100,
      "description": "보고서 이름 대조의 참조. 저장한 후보 수는 침해 건수가 아니며 상세 coverage/한계는 결과 JSON을 따른다.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "analysis_path",
          "sha256",
          "status",
          "matches_total",
          "partition",
          "firmware_result_path",
          "fs_list_path"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^EV-[0-9]{4,6}$",
            "maxLength": 9
          },
          "analysis_path": {
            "type": "string",
            "pattern": "^forensics/analysis/sd-ioc-scan-EV-[0-9]{4,6}-[0-9]{3,9}\\.json$",
            "maxLength": 100
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "status": {
            "enum": [
              "ok",
              "partial",
              "unsupported"
            ]
          },
          "matches_total": {
            "type": "integer",
            "minimum": 0,
            "maximum": 200
          },
          "partition": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 4096
          },
          "firmware_result_path": {
            "type": "string",
            "pattern": "^analysis/sd-surface-[0-9]{3,9}\\.json$",
            "maxLength": 80
          },
          "fs_list_path": {
            "type": "string",
            "pattern": "^forensics/analysis/fs-list-EV-[0-9]{4,6}-[0-9]{3,9}\\.json$",
            "maxLength": 100
          }
        }
      }
    },
    "media_candidate_results": {
      "type": "array",
      "maxItems": 100,
