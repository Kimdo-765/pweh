{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "pweh.secrets-scan/v1"
    },
    "status": {
      "enum": [
        "ok",
        "partial",
        "unsupported"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "evidence"
        },
        "evidence_id": {
          "type": "string",
          "pattern": "^EV-[0-9]{4,6}$",
          "maxLength": 9
        },
        "evidence_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "container": {
          "enum": [
            "file",
            "tar",
            "zip",
            "filesystem"
          ]
        },
        "member_selected": {
          "type": "boolean"
        },
        "selected_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "selected_size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4194304
        },
        "complete": {
          "const": true
        },
        "method": {
          "enum": [
            "whole-file",
            "archive-member",
            "chain",
            "nofatchain",
            "contiguous",
            "skip-allocated",
            "skip-claimed",
            "fat-chain",
            "stale-chain"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "partition": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 65535
        },
        "ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 50,
          "pattern": "^(?:[0-9a-z+]{1,40}/[0-9]{1,9}|arc:[0-9]{1,9})$"
        },
        "deleted": {
          "type": "boolean"
        },
        "container_truncated": {
          "type": "boolean"
        },
        "container_truncated_reasons": {
          "type": "array",
          "items": {
            "enum": [
              "time",
              "cancelled",
              "unsupported_archive_compression",
              "incomplete_archive",
              "max_metadata",
              "max_entries",
              "invalid_archive",
              "unsupported_archive",
              "trailing_data_unexamined",
              "trailing_data",
              "unsupported_sparse",
              "unknown_container_limit"
            ]
          },
          "minItems": 0,
          "maxItems": 12,
          "uniqueItems": true
        }
      },
      "required": [
        "kind",
        "evidence_id",
        "evidence_sha256",
        "container",
        "member_selected",
        "selected_sha256",
        "selected_size",
        "complete",
        "method",
        "confidence"
      ]
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "xor_key": {
          "enum": [
            null,
            144
          ]
        },
        "max_hits": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "max_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 45
        },
        "decoder": {
          "const": "utf-8"
        }
      },
      "required": [
        "xor_key",
        "max_hits",
        "max_seconds",
        "decoder"
      ]
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pack": {
          "const": "pweh-credential-spans-v1"
        },
        "pattern_ids": {
          "const": [
            "builtin-config-password",
            "builtin-xml-password",
            "builtin-url-credential",
            "builtin-quoted-password",
            "console-space-password",
            "console-quoted-value",
            "console-authorization",
            "console-bearer",
            "console-jwt",
            "console-xml-secret",
            "console-url-credential",
            "scanner-explicit-credential"
          ]
        }
      },
      "required": [
        "pack",
        "pattern_ids"
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4194304
        },
        "read_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4194304
        },
        "scanned_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4194304
        },
        "framing_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4194304
        },
        "unscanned_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4194304
        },
        "scanned_ranges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "offset": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4194304
              },
              "length": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4194304
              },
              "framing_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4194304
              }
            },
            "required": [
              "offset",
              "length",
              "framing_bytes"
            ]
          },
          "minItems": 0,
          "maxItems": 1024
        },
        "unscanned_ranges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "offset": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4194304
              },
              "length": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4194304
              },
              "reason": {
                "enum": [
                  "line_too_long",
                  "line_limit",
                  "hit_limit",
                  "range_limit",
                  "output_limit",
                  "time_limit",
                  "selection_uncertain",
                  "container_listing_incomplete",
                  "unsupported_media",
                  "invalid_utf8",
                  "unsupported_encoding",
                  "unsupported_unicode"
                ]
              }
            },
            "required": [
              "offset",
              "length",
              "reason"
            ]
          },
          "minItems": 0,
          "maxItems": 1024
        },
        "lines_seen": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "lines_scanned": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "lines_skipped": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "analysis_complete": {
          "type": "boolean"
        },
        "container_examined": {
          "const": false
        },
        "selection_uncertain": {
          "type": "boolean"
        },
        "hits_are_lower_bound": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "items": {
            "enum": [
              "line_too_long",
              "line_limit",
              "hit_limit",
              "range_limit",
              "output_limit",
              "time_limit",
              "selection_uncertain",
              "container_listing_incomplete",
              "unsupported_media",
              "invalid_utf8",
              "unsupported_encoding",
              "unsupported_unicode"
            ]
          },
          "minItems": 0,
          "maxItems": 12,
          "uniqueItems": true
        }
      },
      "required": [
        "input_bytes",
        "read_bytes",
        "scanned_bytes",
        "framing_bytes",
        "unscanned_bytes",
        "scanned_ranges",
        "unscanned_ranges",
        "lines_seen",
        "lines_scanned",
        "lines_skipped",
        "analysis_complete",
        "container_examined",
        "selection_uncertain",
        "hits_are_lower_bound",
        "reasons"
      ]
    },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "pattern_ids": {
            "type": "array",
            "items": {
              "enum": [
                "builtin-config-password",
                "builtin-xml-password",
                "builtin-url-credential",
                "builtin-quoted-password",
                "console-space-password",
                "console-quoted-value",
                "console-authorization",
                "console-bearer",
                "console-jwt",
                "console-xml-secret",
                "console-url-credential",
                "scanner-explicit-credential"
              ]
            },
            "minItems": 1,
            "maxItems": 12,
            "uniqueItems": true
          },
          "kind": {
            "enum": [
              "password",
              "token",
              "authorization",
              "url-password"
            ]
          },
          "line": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4194304
          },
          "length": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16384
          },
          "masked": {
            "const": "<masked>"
          },
          "value_complete": {
            "type": "boolean"
          },
          "digest": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^sha256:[0-9a-f]{16}$",
            "maxLength": 23
          },
          "confidence": {
            "const": "possible"
          }
        },
        "required": [
          "pattern_ids",
          "kind",
          "line",
          "offset",
          "length",
          "masked",
          "value_complete",
          "digest",
          "confidence"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "value_complete": {
                  "const": false
                }
              }
            },
            "then": {
              "properties": {
                "digest": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "value_complete": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "digest": {
                  "type": "string"
                }
              }
            }
          }
        ]
      },
      "minItems": 0,
      "maxItems": 200
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "by_kind": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "password": {
              "type": "integer",
              "minimum": 0,
              "maximum": 200
            },
            "token": {
              "type": "integer",
              "minimum": 0,
              "maximum": 200
            },
            "authorization": {
              "type": "integer",
              "minimum": 0,
              "maximum": 200
            },
            "url-password": {
              "type": "integer",
              "minimum": 0,
              "maximum": 200
            }
          },
          "required": [
            "password",
            "token",
            "authorization",
            "url-password"
          ]
        },
        "unique_digest_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        }
      },
      "required": [
        "hits",
        "by_kind",
        "unique_digest_count"
      ]
    },
    "limitations": {
      "const": [
        "heuristic_candidates_only",
        "utf8_only",
        "single_selected_file_only",
        "no_multiline_secrets",
        "no_hash_cracking",
        "no_authentication",
        "no_media_decoding",
        "no_plaintext_output"
      ]
    }
  },
  "required": [
    "schema",
    "status",
    "source",
    "params",
    "rules",
    "coverage",
    "matches",
    "summary",
    "limitations"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pweh.local/schemas/secrets-scan.schema.json",
  "title": "선택 파일 비밀값 후보 검사 보고서",
  "description": "고정 규칙·좌표·마스킹·케이스 솔트 지문만 보존한다. 키·값·계정·URL·파일명·발췌는 금지한다."
}
