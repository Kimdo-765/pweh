{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "pweh.dhav-scan/v1"
    },
    "profile": {
      "const": "dhav-stream-framing-v1"
    },
    "status": {
      "enum": [
        "ok",
        "partial",
        "unsupported"
      ]
    },
    "payload_semantics_examined": {
      "const": false
    },
    "extension_fields_examined": {
      "const": false
    },
    "checksum_verified": {
      "const": false
    },
    "media_decoded": {
      "const": false
    },
    "playback_verified": {
      "const": false
    },
    "recording_time_verified": {
      "const": false
    },
    "encryption_assessed": {
      "const": false
    },
    "original_file_boundary_verified": {
      "const": false
    },
    "complete_recording": {
      "const": false
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "anchors_observed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1025
        },
        "anchors_rejected": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        },
        "incomplete_anchors": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        },
        "oversize_anchors": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        },
        "candidates_reported": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "anchor_rejections": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "unsupported_record_type": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1024
            },
            "length_below_header_and_footer": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1024
            },
            "empty_payload": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1024
            },
            "footer_missing": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1024
            },
            "footer_length_mismatch": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1024
            }
          },
          "required": [
            "unsupported_record_type",
            "length_below_header_and_footer",
            "empty_payload",
            "footer_missing",
            "footer_length_mismatch"
          ]
        },
        "anchor_incomplete": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "truncated_header": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1024
            },
            "record_beyond_evidence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1024
            }
          },
          "required": [
            "truncated_header",
            "record_beyond_evidence"
          ]
        }
      },
      "required": [
        "anchors_observed",
        "anchors_rejected",
        "incomplete_anchors",
        "oversize_anchors",
        "candidates_reported",
        "anchor_rejections",
        "anchor_incomplete"
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidence_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "start_offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "max_scan_bytes": {
          "type": "integer",
          "minimum": 4,
          "maximum": 1073741824
        },
        "search_positions_total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "positions_before_start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "search_positions_examined": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1073741824
        },
        "unexamined_positions": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9223372036854775807
                },
                "count": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9223372036854775807
                },
                "reason": {
                  "enum": [
                    "scan_byte_limit",
                    "probe_limit",
                    "candidate_limit",
                    "structure_byte_limit",
                    "output_limit",
                    "time_limit"
                  ]
                }
              },
              "required": [
                "start",
                "count",
                "reason"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "pending_anchor_offset": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "next_offset": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "search_complete": {
          "type": "boolean"
        },
        "whole_evidence_search_complete": {
          "type": "boolean"
        },
        "candidate_checks_complete": {
          "type": "boolean"
        },
        "candidate_list_complete": {
          "type": "boolean"
        },
        "anchor_probes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        },
        "search_bytes_read": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1073741824
        },
        "search_read_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16384
        },
        "structure_bytes_read": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "structure_read_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "total_bytes_read": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1074790400
        },
        "reasons": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 8,
          "items": {
            "enum": [
              "scan_byte_limit",
              "probe_limit",
              "candidate_limit",
              "structure_byte_limit",
              "output_limit",
              "time_limit",
              "record_framing_incomplete",
              "record_size_limit"
            ]
          }
        }
      },
      "required": [
        "evidence_size",
        "start_offset",
        "max_scan_bytes",
        "search_positions_total",
        "positions_before_start",
        "search_positions_examined",
        "unexamined_positions",
        "pending_anchor_offset",
        "next_offset",
        "search_complete",
        "whole_evidence_search_complete",
        "candidate_checks_complete",
        "candidate_list_complete",
        "anchor_probes",
        "search_bytes_read",
        "search_read_calls",
        "structure_bytes_read",
        "structure_read_calls",
        "total_bytes_read",
        "reasons"
      ]
    },
    "candidates": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "record_length": {
            "type": "integer",
            "minimum": 33,
            "maximum": 67108864
          },
          "header_length": {
            "type": "integer",
            "minimum": 24,
            "maximum": 279
          },
          "extension_length": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "payload_length": {
            "type": "integer",
            "minimum": 1,
            "maximum": 67108832
          },
          "record_type": {
            "enum": [
              "type_f0",
              "type_fc",
              "type_fd"
            ]
          },
          "footer_length_matches": {
            "const": true
          },
          "confidence": {
            "const": "possible"
          }
        },
        "required": [
          "index",
          "offset",
          "record_length",
          "header_length",
          "extension_length",
          "payload_length",
          "record_type",
          "footer_length_matches",
          "confidence"
        ]
      }
    },
    "limitations": {
      "const": [
        "record_framing_subset_only",
        "payload_semantics_unexamined",
        "extension_fields_unexamined",
        "header_checksum_unverified",
        "original_file_boundary_unknown",
        "no_media_type_confirmation",
        "no_playback_time_or_encryption_validation",
        "evidence_bytes_only",
        "allocation_state_unexamined",
        "record_bytes_not_hashed",
        "range_revalidation_required_before_extract",
        "intake_hash_not_reverified"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "evidence"
        },
        "evidence_id": {
          "type": "string",
          "pattern": "^EV-[0-9]{4,6}$"
        },
        "evidence_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "evidence_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "kind",
        "evidence_id",
        "evidence_sha256",
        "evidence_size"
      ]
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start_offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "max_scan_bytes": {
          "type": "integer",
          "minimum": 4,
          "maximum": 1073741824
        },
        "max_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 45
        }
      },
      "required": [
        "start_offset",
        "max_scan_bytes",
        "max_seconds"
      ]
    }
  },
  "required": [
    "schema",
    "profile",
    "status",
    "payload_semantics_examined",
    "extension_fields_examined",
    "checksum_verified",
    "media_decoded",
    "playback_verified",
    "recording_time_verified",
    "encryption_assessed",
    "original_file_boundary_verified",
    "complete_recording",
    "summary",
    "coverage",
    "candidates",
    "limitations",
    "source",
    "params"
  ]
}
