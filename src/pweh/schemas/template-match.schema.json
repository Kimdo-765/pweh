{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "저장 PNG 영역 비교 보고서",
  "type": "object",
  "properties": {
    "schema": {
      "const": "pweh.template-match/v1"
    },
    "profile": {
      "const": "stored-png-roi-rgb-mae-v1"
    },
    "sources": {
      "type": "object",
      "properties": {
        "reference": {
          "$ref": "#/$defs/source"
        },
        "candidate": {
          "$ref": "#/$defs/source"
        }
      },
      "required": [
        "reference",
        "candidate"
      ],
      "additionalProperties": false
    },
    "reference_roi": {
      "$ref": "#/$defs/roi"
    },
    "candidate_roi": {
      "$ref": "#/$defs/roi"
    },
    "max_mean_error": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "result": {
      "type": "object",
      "properties": {
        "sum_abs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1958400000
        },
        "samples": {
          "type": "integer",
          "minimum": 3,
          "maximum": 7680000
        },
        "mean_abs_error": {
          "type": "number",
          "minimum": 0,
          "maximum": 255
        },
        "matched": {
          "type": "boolean"
        }
      },
      "required": [
        "sum_abs",
        "samples",
        "mean_abs_error",
        "matched"
      ],
      "additionalProperties": false
    },
    "frame_freshness_verified": {
      "const": false
    },
    "game_semantics_verified": {
      "const": false
    },
    "action_generated": {
      "const": false
    },
    "limitations": {
      "const": [
        "stored_preview_pixels_only",
        "equal_roi_dimensions_only",
        "rgb_mean_absolute_error_only",
        "no_frame_freshness_verification",
        "no_game_semantics_verification",
        "no_action_generation"
      ]
    }
  },
  "required": [
    "schema",
    "profile",
    "sources",
    "reference_roi",
    "candidate_roi",
    "max_mean_error",
    "result",
    "frame_freshness_verified",
    "game_semantics_verified",
    "action_generated",
    "limitations"
  ],
  "additionalProperties": false,
  "$defs": {
    "artifact_id": {
      "type": "string",
      "pattern": "^A-[0-9]{4,8}$(?![\\s\\S])"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
    },
    "roi": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 1600
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 1600
        },
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 1600
        },
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 1600
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "source": {
      "type": "object",
      "properties": {
        "report": {
          "type": "object",
          "properties": {
            "artifact_id": {
              "$ref": "#/$defs/artifact_id"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8388608
            }
          },
          "required": [
            "artifact_id",
            "sha256",
            "size"
          ],
          "additionalProperties": false
        },
        "preview": {
          "type": "object",
          "properties": {
            "index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1
            },
            "artifact_id": {
              "$ref": "#/$defs/artifact_id"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048576
            },
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1600
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1600
            },
            "role": {
              "enum": [
                "overview",
                "crop"
              ]
            }
          },
          "required": [
            "index",
            "artifact_id",
            "sha256",
            "size",
            "width",
            "height",
            "role"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "report",
        "preview"
      ],
      "additionalProperties": false
    }
  }
}
