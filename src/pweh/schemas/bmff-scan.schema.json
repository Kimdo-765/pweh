{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "pweh.bmff-scan/v1"
    },
    "profile": {
      "const": "ftyp-stream-prefix-v1"
    },
    "status": {
      "enum": [
        "ok",
        "partial",
        "unsupported"
      ]
    },
    "media_decoded": {
      "const": false
    },
    "playback_verified": {
      "const": false
    },
    "recording_time_verified": {
      "const": false
    },
    "encryption_assessed": {
      "const": false
    },
    "format_conformance_assessed": {
      "const": false
    },
    "original_file_boundary_verified": {
      "const": false
    },
    "physical_carving_performed": {
      "const": false
    },
    "relations_assessed": {
      "const": false
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "anchors_observed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1025
        },
        "anchors_rejected": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        },
        "oversize_anchors": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        },
        "candidates_reported": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "chain_limited_candidates": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "anchor_rejections": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "size_zero": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1024
            },
            "truncated_extended_header": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1024
            },
            "size_below_header": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1024
            },
            "box_beyond_evidence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1024
            },
            "invalid_ftyp_shape": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1024
            },
            "unknown_brand": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1024
            }
          },
          "required": [
            "size_zero",
            "truncated_extended_header",
            "size_below_header",
            "box_beyond_evidence",
            "invalid_ftyp_shape",
            "unknown_brand"
          ]
        }
      },
      "required": [
        "anchors_observed",
        "anchors_rejected",
        "oversize_anchors",
        "candidates_reported",
        "chain_limited_candidates",
        "anchor_rejections"
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidence_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "start_offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "max_scan_bytes": {
          "type": "integer",
          "minimum": 8,
          "maximum": 1073741824
        },
        "search_positions_total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "positions_before_start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "search_positions_examined": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1073741824
        },
        "unexamined_positions": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9223372036854775807
                },
                "count": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9223372036854775807
                },
                "reason": {
                  "enum": [
                    "scan_byte_limit",
                    "probe_limit",
                    "candidate_limit",
                    "box_limit",
                    "brand_limit",
                    "structure_byte_limit",
                    "output_limit",
                    "time_limit"
                  ]
                }
              },
              "required": [
                "start",
                "count",
                "reason"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "pending_anchor_offset": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "next_offset": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "search_complete": {
          "type": "boolean"
        },
        "whole_evidence_search_complete": {
          "type": "boolean"
        },
        "candidate_checks_complete": {
          "type": "boolean"
        },
        "candidate_list_complete": {
          "type": "boolean"
        },
        "anchor_probes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        },
        "search_bytes_read": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1073741824
        },
        "search_read_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16384
        },
        "structure_bytes_read": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "structure_read_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20480
        },
        "total_bytes_read": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1074790400
        },
        "reasons": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 10,
          "items": {
            "enum": [
              "scan_byte_limit",
              "probe_limit",
              "candidate_limit",
              "box_limit",
              "brand_limit",
              "structure_byte_limit",
              "output_limit",
              "time_limit",
              "prefix_size_limit",
              "candidate_framing_partial"
            ]
          }
        },
        "boxes_examined": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8192
        },
        "brand_slots_examined": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        }
      },
      "required": [
        "evidence_size",
        "start_offset",
        "max_scan_bytes",
        "search_positions_total",
        "positions_before_start",
        "search_positions_examined",
        "unexamined_positions",
        "pending_anchor_offset",
        "next_offset",
        "search_complete",
        "whole_evidence_search_complete",
        "candidate_checks_complete",
        "candidate_list_complete",
        "anchor_probes",
        "search_bytes_read",
        "search_read_calls",
        "structure_bytes_read",
        "structure_read_calls",
        "total_bytes_read",
        "reasons",
        "boxes_examined",
        "brand_slots_examined"
      ]
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775791
          },
          "validated_prefix_length": {
            "type": "integer",
            "minimum": 16,
            "maximum": 67108864
          },
          "boxes_validated": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1024
          },
          "box_counts": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ftyp": {
                "const": 1
              },
              "moov": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1023
              },
              "mdat": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1023
              },
              "moof": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1023
              },
              "styp": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1023
              },
              "free": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1023
              },
              "skip": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1023
              },
              "wide": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1023
              },
              "uuid": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1023
              }
            },
            "required": [
              "ftyp",
              "moov",
              "mdat",
              "moof",
              "styp",
              "free",
              "skip",
              "wide",
              "uuid"
            ]
          },
          "known_brands": {
            "type": "array",
            "items": {
              "enum": [
                "isom",
                "iso2",
                "iso3",
                "iso4",
                "iso5",
                "iso6",
                "mp41",
                "mp42",
                "quicktime"
              ]
            },
            "maxItems": 9,
            "minItems": 1,
            "uniqueItems": true
          },
          "end_reason": {
            "enum": [
              "evidence_end",
              "next_ftyp",
              "size_zero",
              "truncated_header",
              "truncated_extended_header",
              "truncated_uuid_header",
              "size_below_header",
              "box_beyond_evidence",
              "unknown_next_type",
              "unsupported_wide_shape",
              "box_limit",
              "structure_byte_limit",
              "time_limit",
              "prefix_size_limit"
            ]
          },
          "framing_status": {
            "enum": [
              "complete",
              "partial"
            ]
          },
          "confidence": {
            "const": "possible"
          },
          "complete_recording": {
            "const": false
          }
        },
        "required": [
          "index",
          "offset",
          "validated_prefix_length",
          "boxes_validated",
          "box_counts",
          "known_brands",
          "end_reason",
          "framing_status",
          "confidence",
          "complete_recording"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "end_reason": {
                  "enum": [
                    "evidence_end",
                    "next_ftyp"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "framing_status": {
                  "const": "complete"
                }
              }
            },
            "else": {
              "properties": {
                "framing_status": {
                  "const": "partial"
                }
              }
            }
          }
        ]
      },
      "minItems": 0,
      "maxItems": 128
    },
    "limitations": {
      "const": [
        "top_level_framing_only",
        "payload_semantics_unexamined",
        "original_file_boundary_unknown",
        "candidate_relations_unexamined",
        "no_media_type_confirmation",
        "no_playback_time_or_encryption_validation",
        "evidence_bytes_only",
        "allocation_state_unexamined",
        "prefix_bytes_not_hashed",
        "range_revalidation_required_before_extract",
        "intake_hash_not_reverified"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "evidence"
        },
        "evidence_id": {
          "type": "string",
          "pattern": "^EV-[0-9]{4,6}$"
        },
        "evidence_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "evidence_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "kind",
        "evidence_id",
        "evidence_sha256",
        "evidence_size"
      ]
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start_offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "max_scan_bytes": {
          "type": "integer",
          "minimum": 8,
          "maximum": 1073741824
        },
        "max_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 45
        }
      },
      "required": [
        "start_offset",
        "max_scan_bytes",
        "max_seconds"
      ]
    }
  },
  "required": [
    "schema",
    "profile",
    "status",
    "media_decoded",
    "playback_verified",
    "recording_time_verified",
    "encryption_assessed",
    "format_conformance_assessed",
    "original_file_boundary_verified",
    "physical_carving_performed",
    "relations_assessed",
    "summary",
    "coverage",
    "candidates",
    "limitations",
    "source",
    "params"
  ]
}
